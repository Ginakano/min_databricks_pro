            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "3df417a9",
      "displayName": "Sales Orders and Customer Details Overview Dataset",
      "queryLines": [
        "SELECT \r\n",
        "f.order_date,\r\n",
        "f.order_number,\r\n",
        "f.sales_amount,\r\n",
        "f.quantity,\r\n",
        "f.price,\r\n",
        "p.product_key,\r\n",
        "p.product_name,\r\n",
        "p.category,\r\n",
        "c.customer_number,\r\n",
        "concat (c.first_name, ' ', c.last_name) AS customer_name,\r\n",
        "c.birthdate\r\n",
        "FROM workspace.salesdb.fact_sales f\r\n",
        "LEFT JOIN workspace.salesdb.dim_products p\r\n",
        "ON f.product_key = P.product_key\r\n",
        "LEFT JOIN workspace.salesdb.dim_customers c\r\n",
        "ON f.customer_key = c.customer_key\r\n"
      ],
      "catalog": "workspace",
      "schema": "salesdb"
    }
  ],
