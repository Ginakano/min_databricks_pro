{
  "datasets": [
    {
      "name": "58525f79",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "--total orders over time\n",
        "SELECT\n",
        "date_trunc('month', order_date) as orderdate,\n",
        "SUM(sales_amount)\n",
        "FROM workspace.salesdb.fact_sales\n",
        "GROUP BY(date_trunc('month', order_date))"
      ]
    },
    {
      "name": "7102224d",
      "displayName": "Untitled dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `salesdb`;\n",
        "\n",
        "SELECT\n",
        "SUM(sales_amount)as Sales,\n",
        "p.category AS category\n",
        "FROM workspace.salesdb.fact_sales f\n",
        "LEFT JOIN workspace.salesdb.dim_products p\n",
        "ON f.product_key = p.product_key\n",
        "GROUP BY p.category"
      ]
    }
  ],
